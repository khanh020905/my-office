            "type": "command",
            "command": "curl -s --max-time 600 -H 'X-Office-Wait: 600' -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4310/hook/question || true",
            "timeout": 605
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 0.3 -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4310/hook/loop || true",
            "timeout": 2
          }
        ]
      }
    ],
