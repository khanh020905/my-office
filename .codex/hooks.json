    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/plugins/my-office-codex-hooks/hooks/send.mjs\" codex-cli", "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'plugins/my-office-codex-hooks/hooks/send.mjs') codex-cli\"", "timeout": 2 }] }]
